{
  "name": "@webship-js/mautic-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for Mautic, the open-source marketing automation platform, a plugin for webship-js (Playwright and Cucumber): the session and the refusals of a role, the menus, the lists (search, count, sort, the actions of a row), the forms of the administration and their fields, contacts (points, tags, segments, companies, history, notes, an email), segments and their filters, forms and their public page, assets, landing pages, emails, campaigns and the site's scheduled tasks, reports and the dashboard, and the mail the site sends.",
  "main": "tests/step-definitions/mautic-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "tests/fixtures/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "mautic",
    "marketing-automation",
    "email-marketing",
    "crm",
    "segments",
    "campaigns",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/mautic-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/mautic-steps/issues"
  },
  "homepage": "https://github.com/webship/mautic-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
